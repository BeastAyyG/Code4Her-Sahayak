MAHAKHUMB_APP_ENV=production
MAHAKHUMB_ARTIFACT_DIR=.
MAHAKHUMB_SERVER_ALLOWED_ORIGIN=*
MAHAKHUMB_SERVER_ENABLE_CORS=true
MAHAKHUMB_SERVER_MAX_BODY_BYTES=16384
MAHAKHUMB_FORCE_SYNTHETIC=0
MAHAKHUMB_CLUSTER_COUNT=8
MAHAKHUMB_MAX_QAOA_CLUSTERS=4
MAHAKHUMB_QAOA_MAXITER=75
MAHAKHUMB_STGNN_EPOCHS=60
MAHAKHUMB_STREAM_EVENT_COUNT=12
MAHAKHUMB_STREAM_EVENT_INTERVAL_MS=150
